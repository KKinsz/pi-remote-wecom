{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true
  },
  "include": [
    "extensions/**/*.ts",
    "vendor/**/*.ts",
    "daemon/**/*.ts"
  ]
}
