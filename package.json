{
  "name": "pi-remote-wecom",
  "version": "0.3.1",
  "description": "Control multiple local Pi sessions from WeCom, with session naming, attachments, and task results.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "wecom"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "bin": {
    "pi-remote-wecom": "./bin/remote.mjs"
  },
  "files": [
    "extensions",
    "daemon",
    "bin",
    "vendor",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "config.example.json",
    "SECURITY.md",
    "NOTICE.md",
    "CONTRIBUTING.md",
    "RELEASING.md"
  ],
  "dependencies": {
    "@wecom/aibot-node-sdk": "1.0.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "^22.0.0",
    "typebox": "1.3.31",
    "typescript": "~5.9.3",
    "ws": "^8.22.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run check:release",
    "check:release": "node scripts/check-release.mjs",
    "test:package": "node scripts/test-package.mjs",
    "check:public": "node scripts/check-release.mjs --public",
    "prepublishOnly": "npm run check && npm run test:package && npm run check:public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KKinsz/pi-remote-wecom.git"
  },
  "homepage": "https://github.com/KKinsz/pi-remote-wecom",
  "bugs": {
    "url": "https://github.com/KKinsz/pi-remote-wecom/issues"
  }
}
